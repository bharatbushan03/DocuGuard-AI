# =============================================================================
# DocuGuard AI — Docker environment template
# Copy to .env before running:  cp .env.docker .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docuguard
POSTGRES_PORT=5432

# --- Qdrant ---
QDRANT_PORT=6333

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string
OPENAI_API_KEY=your_openai_api_key_here
# JSON array for CORS origins (browser must reach the frontend URL)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (Next.js) ---
# Baked into the image at build time; use the URL your browser uses to reach the API
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
